{
  "name": "relay-dsh-plugin-monitors",
  "version": "0.2.0-rc.1",
  "description": "Durable bound Monitor scheduler and timer provider for Relay Events on DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "monitoring",
    "timers",
    "events"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-monitors.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "prepare:dsh": "scripts/link-dsh-development-peers.sh",
    "pretest": "npm run prepare:dsh",
    "prebuild": "npm run prepare:dsh && node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "node --check host-plugin.js && node --check src/controller.mjs && node --check src/runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "SPEC.md",
    "docs",
    "cordis.patch.yml",
    "lib/host-plugin.js",
    "lib/host-plugin.js.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "relay-dsh-plugin-events": "0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "relay-dsh-plugin-events": {
      "optional": true
    }
  },
  "devDependencies": {
    "relay-dsh-plugin-events": "github:yangbobo2021/relay-dsh-plugin-events#aabf30362ee0e5d374a1f1d6ae1b1f7be8553c6a",
    "tsdown": "0.22.2"
  }
}
